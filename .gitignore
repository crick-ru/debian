# Build output and temp artifacts
build/
dist/
repo-pool/
*.deb
*.ddeb
*.buildinfo
*.changes
*.tar.*
*.dsc
*.upload
*.log

# Debian packaging temporary files
# Шаблоны с ** иначе не сработали бы для вложенных путей вида
# packages/<pkg>/debian/files: шаблон со слешем в .gitignore привязан к
# корню репозитория.
**/debian/.debhelper/
**/debian/*-build/
**/debian/tmp/
**/debian/files
**/debian/substvars
*.substvars

# System and editor files
.DS_Store
*~
*.swp
*.orig
*.rej

# Кэш Python: генерируется при локальных проверках скриптов упаковки
# (python3 -m py_compile и импорт модулей), в репозитории ему не место.
__pycache__/
*.pyc
