# Build output and temp artifacts
build/
dist/
repo-pool/
*.deb
*.ddeb
*.buildinfo
*.changes
*.tar.*
*.dsc
*.upload
*.log

# Debian packaging temporary files
# Шаблоны с ** иначе не сработали бы для вложенных путей вида
# packages/<pkg>/debian/files: шаблон со слешем в .gitignore привязан к
# корню репозитория.
**/debian/.debhelper/
**/debian/*-build/
**/debian/tmp/
**/debian/files
**/debian/substvars
*.substvars

# System and editor files
.DS_Store
*~
*.swp
*.orig
*.rej
