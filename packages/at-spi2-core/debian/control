Source: at-spi2-core
Section: misc
Priority: optional
Maintainer: crick Debian Backports <backports@users.noreply.github.com>
# Упаковка взята из Debian (at-spi2-core_2.56.2-1+deb13u2, ветка 13) и переработана:
#   * X11 отключён (-Dx11=disabled): libatspi.so.0 собирается без libX11/libXi,
#     файл atspi-device-x11.c не компилируется, весь X11-код вырезан по HAVE_X11;
#   * /etc/X11/Xsession.d не ставится - это X11-сессия, а репозиторий
#     публикует только пакеты для чистого Wayland;
#   * тесты не собираются (override_dh_auto_test пуст), документация не
#     собирается (-Ddocs=false), каталог debian/tests удалён;
#   * udeb-пакеты не собираются: это урезанная система Debian Installer;
#   * dbgsym-пакеты не собираются (общее правило scripts/build-package.sh).
# Подробности разбора пакета - в packages/at-spi2-core/README.md.
Build-Depends: dpkg-dev (>= 1.22.5),
               debhelper-compat (= 13),
               dbus,
               libdbus-1-dev,
               dbus-broker [linux-any],
               libsystemd-dev [linux-any],
               libglib2.0-dev (>= 2.62),
               libxml2-dev,
               meson (>= 0.63.0),
               pkgconf,
               gir1.2-dbus-1.0-dev,
               gir1.2-glib-2.0-dev,
               gir1.2-gobject-2.0-dev,
               gobject-introspection | dh-sequence-gir
