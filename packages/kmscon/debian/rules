#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1

include /usr/share/dpkg/buildtools.mk

export DEB_BUILD_MAINT_OPTIONS := qa=+bug hardening=+all reproducible=+all
export DEB_CFLAGS_MAINT_APPEND := -Wno-error=array-bounds
export SYSTEMD_SYSTEM_UNIT_DIR = $(shell $(PKG_CONFIG) --variable=systemdsystemunitdir systemd | sed s,^/,,)

%:
	dh $@ --without single-binary


# The unit tests need libcheck even though they are never run, because
# upstream defaults its `tests` option to true and that is exactly what pulls
# the dependency in. -Dtests=false keeps it out (see .clinerules/project.md);
# `override_dh_auto_test` is empty as well.
override_dh_auto_configure:
	# -Ddocs=disabled unconditionally: no man pages, no docbook tooling, no
	# kmscon.docs.
	# -Dtests=false: upstream defaults this option to true and it is exactly
	# what gates the `check` dependency, so without it meson.build still looks
	# for the unit-test framework even though override_dh_auto_test never runs
	# the tests. See .clinerules/project.md.
	dh_auto_configure -- --auto-features=enabled \
	                     -Ddocs=disabled \
	                     -Dtests=false \
	                     -Dwerror=false \
	                     $(empty)

# The tests are all interactive and/or require root privileges
override_dh_auto_test:

override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

override_dh_installchangelogs:
	dh_installchangelogs NEWS.md
