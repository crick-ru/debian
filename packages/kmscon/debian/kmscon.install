#! /usr/bin/dh-exec
${env:SYSTEMD_SYSTEM_UNIT_DIR}/kmsconvt@.service
debian/kmscon.conf etc/needrestart/conf.d
scripts/etc/kmscon.conf.example => /etc/kmscon/kmscon.conf
usr/bin/kmscon
usr/bin/kmscon-launch-gui
usr/lib/${DEB_HOST_MULTIARCH}/kmscon/mod-*.so
usr/share/man/man5/kmscon.conf.5
# Terminfo entry is built and installed to /usr/share by upstream; Debian
# installs it into /usr/lib/terminfo instead, so that it does not conflict
# with ncurses-term (see https://bugs.debian.org/1142216).
usr/share/terminfo/k/kmscon usr/lib/terminfo/k
