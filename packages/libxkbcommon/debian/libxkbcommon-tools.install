#!/usr/bin/dh-exec
# The xkbcli-*-x11 subcommands and their man pages are absent: the X11 part of
# xkbcommon is not built (-Denable-x11=false, see debian/rules).

usr/bin/xkbcli
usr/libexec/xkbcommon/xkbcli-compile-compose
usr/libexec/xkbcommon/xkbcli-compile-keymap
usr/libexec/xkbcommon/xkbcli-dump-keymap
[linux-any] usr/libexec/xkbcommon/xkbcli-dump-keymap-wayland
usr/libexec/xkbcommon/xkbcli-how-to-type
usr/libexec/xkbcommon/xkbcli-interactive
[linux-any] usr/libexec/xkbcommon/xkbcli-interactive-evdev
[linux-any] usr/libexec/xkbcommon/xkbcli-interactive-wayland
usr/libexec/xkbcommon/xkbcli-list
usr/share/bash-completion/completions/xkbcli
usr/share/man/man1/xkbcli.1
usr/share/man/man1/xkbcli-compile-compose.1
usr/share/man/man1/xkbcli-compile-keymap.1
[linux-any] usr/share/man/man1/xkbcli-dump-keymap-wayland.1
usr/share/man/man1/xkbcli-how-to-type.1
[linux-any] usr/share/man/man1/xkbcli-interactive-evdev.1
[linux-any] usr/share/man/man1/xkbcli-interactive-wayland.1
usr/share/man/man1/xkbcli-list.1

