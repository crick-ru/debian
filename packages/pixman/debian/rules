#!/usr/bin/make -f

PACKAGE = libpixman-1-0
SHLIBS  = 0.40.0

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# Disable Gtk+ autodetection:
override_dh_auto_configure:
	# also avoid loongson2f optimizations on mipsel, see 0.26.0-3
	# changelog entry:
	LS_CFLAGS=" " dh_auto_configure -- \
		-Dgtk=disabled

# Install in debian/tmp to retain control through dh_install:
override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

# Kill *.la files, and forget no-one:
override_dh_install:
	find debian/tmp -name '*.la' -delete
	dh_install

# Shlibs:
override_dh_makeshlibs:
	dh_makeshlibs -p$(PACKAGE) --add-udeb $(PACKAGE)-udeb -V"$(PACKAGE) (>= $(SHLIBS))" -- -c4

# No test suite: this repository does not build or run tests, see
# the repository rules. The pixman test suite is long and needs no CPU
# validation of the shipped library.
override_dh_auto_test:

# The build script forces "3.0 (quilt)" as source format (see
# scripts/build-package.sh), so dpkg-source applies debian/patches itself;
# the quilt add-on of dh must not apply them a second time.
%:
	dh $@ --builddirectory=build/
