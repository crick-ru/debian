#!/usr/bin/make -f
#export DH_VERBOSE = 1

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	# -Dexamples=false: the example programs (including examples/cairo-buffer,
	# the only reason wlroots needed cairo) are not built, so the package
	# libwlroots-0.20-examples is gone. See .clinerules/project.md.
	dh_auto_configure -- -Dbackends=drm,libinput -Dxwayland=disabled -Dxcb-errors=disabled -Dexamples=false
