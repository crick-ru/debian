#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -Wl,-z,defs

%:
	dh $@ --buildsystem=meson

# The Rust build pulls its crates from crates.io and from a git repository at
# build time. Patch 01_locked_cargo_build adds --locked so that cargo uses the
# versions pinned in the Cargo.lock shipped in the tarball instead of
# resolving them again.
#
# RUST_LOG=off silences cargo's progress chatter in the build log; compiler
# warnings still come through.
export RUST_LOG = off

# No tests are built and none are run: this repository neither builds nor runs
# test suites, see the repository rules. Upstream registers three meson
# tests (validate-desktop, validate-appdata, validate-gschema); they are
# validation checks rather than a test system, and none of them is run here.
override_dh_auto_test:

# Единственный бинарный пакет: без явного --destdir dh_auto_install ставит
# файлы прямо в debian/pwvucontrol, а dh_install ищет их в debian/tmp и падает
# с «Cannot find ... (tried in ., debian/tmp)». Явный destdir возвращает
# сборку к обычной схеме: файлы попадают в debian/tmp, их переносит
# debian/pwvucontrol.install, а dh_missing --fail-missing проверяет, что
# ничего не забыто.
override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp
