#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DPKG_GENSYMBOLS_CHECK_LEVEL = 4

# X11 нет нигде в репозитории, поэтому и не собирается: -Dx11=disabled убирает
# из libEGL.so.1 платформу X11 (за неё отвечает макрос ENABLE_EGL_X11, который
# meson ставит только при найденной зависимости x11), а -Dglx=disabled отключает
# сам GLX. Проверено сборкой: в NEEDED готовых libEGL.so.1 и libGLdispatch.so.0
# остаются только libGLdispatch.so.0 и libc.so.6, а строк libX11.so.6 и
# libGLX.so.0 в бинарниках нет вовсе.
# GL, OpenGL и OpenGL ES тоже не публикуются: GL у нас не собирается (mesa
# собрана с -Dglx=disabled), и эти обёртки без него бессмысленны.
# GLES публикуется: в src/meson.build subdir('GLX') и subdir('GL') стоят под
# if with_glx, а GLESv1/GLESv2 - под независимыми опциями gles1/gles2. При
# -Dglx=disabled GLES собирается целиком и не тянет за собой ни X11, ни GL:
# libGLESv1_CM.so.1 и libGLESv2.so.2 в NEEDED имеют только libGLdispatch.so.0
# и libc.so.6. Символы против штатных не отличаются (145 и 358, потерь нет).
conf_flags = \
	-Dx11=disabled \
	-Dglx=disabled \
	-Dgles1=true \
	-Dgles2=true \
	-Dentrypoint-patching=disabled \
	-Dhgl=false

%:
	dh $@ --buildsystem=meson --without autoreconf

override_dh_auto_configure:
	dh_auto_configure -- $(conf_flags)

# Тесты апстрима гоняются через xvfb и проверяют GLX - того, что здесь нет.
override_dh_auto_test:
	# тесты не собираются (общее правило репозитория)

override_dh_auto_install:
	dh_auto_install
	# Состав установки при наших флагах проверен (meson install): остаются
	# libEGL.so*, libGLdispatch.so*, libGLESv1_CM.so*, libGLESv2.so*,
	# libOpenGL.so*, заголовки EGL/, GLES/, GLES2/, GLES3/, glvnd/, KHR/ и
	# пять pkg-config (egl.pc, libglvnd.pc, glesv1_cm.pc, glesv2.pc,
	# opengl.pc). libOpenGL нужен: GLES линкует его статическую часть
	# libopengl_main, а сам он - общий доступ к GL/GLES-функциям для
	# приложений, собранных с opengl.pc.
	#
	# Заголовки GL/ (gl.h, glext.h, glcorearb.h) публикуются в libopengl-dev,
# а KHR/ - в libegl-dev. Удалять их из дерева неверно:
# gstreamer1.0-plugins-base включает <GL/gl.h> при сборке libgstgl
# (gst-libs/gst/gl/gstglfuncs.h:71), а EGL/eglplatform.h включает
# <KHR/khrplatform.h>, то есть без них сборка падает с
# "GL/gl.h: No such file or directory". Заголовки сами по себе не тянут
# ни GLX, ни X11, поэтому публикуются; не публикуются GLX и libGL.so.

override_dh_missing:
	dh_missing --list-missing
