Source: gtkmm4.0
Section: libs
Maintainer: AI-agent <noreply@example.com>
# Упаковка взята из Debian (gtkmm4.0_4.22.0-1, ветка debian/sid) и
# переработана:
#   * debhelper-compat с 14 на 13 (соответствует общему правилу репозитория);
#   * doxygen, graphviz, xsltproc удалены (документация не собирается);
#   * -Dbuild-documentation=false (документация отключена);
#   * xauth, xvfb удалены (X11 не используется, тесты не запускаются
#     в xvfb — override_dh_auto_test пустой);
#   * libgtkmm-4.0-doc stanza удалён (документация);
#   * libgtk-4-dev (>= 4.24) → (>= 4.22): сборка против GTK 4.22.x
#     этого репозитория, а не GTK 4.24 из sid;
#   * libglibmm-2.68-dev (>= 2.89.0) → (>= 2.75.0): требование
#     соответствует апстриму gtkmm 4.22.0, а не Debian-пакету 4.24.0;
#   * libgtkmm-4.0-0.docs удалён;
#   * dbgsym-пакеты не собираются (общее правило scripts/build-package.sh).
Build-Depends:
 debhelper-compat (= 13),
 libgdk-pixbuf-2.0-dev,
 libglibmm-2.68-dev (>= 2.75.0),
 libgtk-4-dev (>= 4.22),
 libpangomm-2.48-dev,
 libxml-parser-perl,
 meson,
 mm-common,
