#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -Wl,-z,defs

%:
	dh $@ --buildsystem=meson

# No documentation and no man pages are built: DOCS=disabled unconditionally.
# Upstream would build the API reference with doxygen and sphinx, so the package
# wireplumber-doc and the files wireplumber-doc.* are gone and doxygen,
# python3-breathe, python3-sphinx and python3-sphinx-rtd-theme are not build
# dependencies. -Dtests=false and -Ddbus-tests=false keep the test tree and the
# test helper binaries out of the build. See .clinerules/project.md.
#
# -Dintrospection=disabled removes gir1.2-wp-0.5 from the package set. Upstream
# builds docs/meson.build unconditionally, and there the introspection path is
# what forces the two heavy build dependencies: python3-lxml is required when
# the option is enabled, and doxygen is then found with required: true - in
# trixie that is 9 extra packages, ~150 MB of libllvm19/libclang-cpp19 for one
# generated typelib that nothing in this repository consumes. See
# packages/wireplumber/README.md for the impact and the way back.
override_dh_auto_configure:
	dh_auto_configure -- \
		-Dmodules=true \
		-Ddaemon=true \
		-Dtools=true \
		-Dsystem-lua=true \
		-Dsystemd=enabled \
		-Dsystemd-system-service=true \
		-Dsystemd-user-service=true \
		-Ddoc=disabled \
		-Dintrospection=disabled \
		-Dtests=false \
		-Ddbus-tests=false \
		$(NULL)

override_dh_makeshlibs:
	dh_makeshlibs \
		--exclude=/usr/lib/$(DEB_HOST_MULTIARCH)/wireplumber-0.5 \
		-- -c4

# Upstream installs the example configurations from
# src/config/meson.build as plain data: install_subdir('wireplumber.conf.d.examples')
# goes to /usr/share/doc/wireplumber/examples/wireplumber.conf.d, and there is
# no option to turn that off. The same configurations are already installed as
# /usr/share/wireplumber/wireplumber.conf.d, so the examples add nothing, and
# the repository does not publish examples at all. The directory is therefore
# removed from the staging tree, exactly like the ffmpeg examples; that keeps
# dh_missing --fail-missing working instead of hiding the files in
# debian/not-installed.
override_dh_auto_install:
	dh_auto_install
	rm -rf debian/tmp/usr/share/doc/wireplumber/examples

# No test suite: this repository neither builds nor runs tests, see
# .clinerules/project.md. -Dtests=false already keeps the test tree out of the
# build, so there is nothing left to run.
override_dh_auto_test:

# The recommended way of installing wireplumber is using user services, but we
# install system services anyway for specific use cases (like embedded and
# accessibility) without enabling/starting them to avoid clashes.
override_dh_installsystemd:
	dh_installsystemd -pwireplumber-system-services --no-enable --no-start
