#!/usr/bin/make -f
# Сборка dummyx11: пакет без исходников, состоящий только из заглушек X11
# и apt-хука. Подробности - в packages/dummyx11/README.md.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

STUBDIR := debian/stubs
BUILDDIR := $(CURDIR)/build-stubs
# DEB_HOST_MULTIARCH, а не $(shell dpkg-architecture ...): переменную
# экспортирует dpkg-buildpackage, и в правилах она уже есть. `:=` здесь
# не годится: значение вычисляется на момент чтения строки, когда make
# ещё не видел окружения сборки, и каталог получался пустым.
LIBDIR   := debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)

%:
	dh $@

# Сгенерировать библиотеки-заглушки. Списки символов лежат в debian/stubs/
# (сняты с настоящих библиотек триxie readelf --dyn-syms), а скрипт
# генерирует из них .so с теми же SONAME.
override_dh_auto_build:
	python3 $(STUBDIR)/gen-stubs.py $(BUILDDIR)

override_dh_auto_install:
	install -d $(LIBDIR)
	install -m 0644 $(BUILDDIR)/lib*.so.* $(LIBDIR)/
	# Хук apt: после каждой операции apt/dpkg проверяет, что браузер (и другие
	# подменённые программы) не остались без заглушек. Кладём его в
	# /etc/apt/apt.conf.d, откуда apt читает конфигурацию автоматически.
	install -d debian/tmp/etc/apt/apt.conf.d
	install -m 0644 $(STUBDIR)/dummyx11.hook debian/tmp/etc/apt/apt.conf.d/
	install -d debian/tmp/usr/share/dummyx11
	install -m 0755 $(STUBDIR)/check-stubs.py debian/tmp/usr/share/dummyx11/
	install -m 0755 $(STUBDIR)/gen-stubs.py debian/tmp/usr/share/dummyx11/
	# Списки символов ставятся вместе со скриптом проверки: тот сверяет
	# импорты браузера именно с ними, и без них хук не смог бы ничего
	# проверить (см. known_symbols() в check-stubs.py).
	install -m 0644 $(STUBDIR)/symbols-*.txt debian/tmp/usr/share/dummyx11/

# Хук вызывается из apt как APT::Update::Post-Invoke-Success и
# DPkg::Post-Invoke, то есть после каждого apt upgrade и после каждого
# вызова dpkg из apt. Он не должен ничего ломать при возврате ненуля:
# apt трактует ненулевой код хука как ошибку всей операции.
override_dh_postinst:
	dh_postinst
	/usr/share/dummyx11/check-stubs.py --quiet || true

override_dh_postrm:
	dh_postrm