#!/usr/bin/make -f
# -*- makefile -*-
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
# DH_VERBOSE = 1

# see FEATURE AREAS in dpkg-buildflags(1)
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

# see ENVIRONMENT in dpkg-buildflags(1)
# package maintainers to append CFLAGS
export DEB_CFLAGS_MAINT_APPEND  = -Wall -pedantic
# package maintainers to append LDFLAGS
export DEB_LDFLAGS_MAINT_APPEND = -Wl,--as-needed

# see EXAMPLES in dpkg-buildflags(1) and read /usr/share/dpkg/*
DPKG_EXPORT_BUILDFLAGS = 1
include /usr/share/dpkg/default.mk

export DPKG_GENSYMBOLS_CHECK_LEVEL=4

# Только autoconf/autotools; ключ --with-xpm НЕ передаётся, символ gdImageCreateFromXpm
# в заглушке есть всегда (см. README) - X11-зависимости не появляются.
%:
	dh $@ --with autoreconf
override_dh_autoreconf:
	dh_autoreconf --as-needed
override_dh_auto_configure:
	dh_auto_configure -- \
		--disable-rpath \
		--with-tiff=/usr \
		--without-raqm \
		--without-xpm \
		--with-avif=/usr \
		--with-heif=/usr \
		--libdir=\$${prefix}/lib/$(DEB_HOST_MULTIARCH)

override_dh_install:
	dh_install --fail-missing -Xlibgd.la -Xgdlib-config

# Тесты не собираются и не запускаются: каталог debian/tests удалён, примеры
# не публикуются (правило репозитория «документация, примеры и тесты не
# собираются»). override_dh_auto_test намеренно пуст: тестовая сборочная
# система не запускается ни при каких профилях (nodoc, nocheck).
override_dh_auto_test:

# override_dh_strip из Debian (миграция со старого libgd-dbg) убран: dbgsym-пакеты
# не собираются (общее правило scripts/build-package.sh), а libgd-dbg из trixie
# от этого не страдает.
