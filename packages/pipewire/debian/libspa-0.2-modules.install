# spa-0.2/test is not listed: it is the test helper library of the upstream
# test suite, and this repository does not build tests (see
# the repository rules). The audiotestsrc/videotestsrc plugins ARE listed:
# they are ordinary spa modules that ship in the main modules package, and
# nothing builds them as part of the test suite.
usr/lib/*/spa-0.2/aec
usr/lib/*/spa-0.2/alsa
usr/lib/*/spa-0.2/audioconvert
usr/lib/*/spa-0.2/audiomixer
usr/lib/*/spa-0.2/audiotestsrc
usr/lib/*/spa-0.2/avb
usr/lib/*/spa-0.2/control
usr/lib/*/spa-0.2/filter-graph
usr/lib/*/spa-0.2/libspa.so
usr/lib/*/spa-0.2/support
usr/lib/*/spa-0.2/videoconvert
usr/lib/*/spa-0.2/videotestsrc
