#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -Wl,-z,defs

%:
	dh $@

# JACK and V4L2 are switched off at configure time, but upstream still builds a
# few unconditional targets: the jack module, the netjack2 modules, pw-jack,
# pw-v4l2, their man pages and jack.conf. They have no package any more, so drop
# them from the staging directory; otherwise dh_missing --fail-missing (the
# compat 13 default) aborts the build.
override_dh_auto_install:
	dh_auto_install
	rm -f debian/tmp/usr/bin/pw-jack debian/tmp/usr/bin/pw-v4l2 \
	      debian/tmp/usr/share/pipewire/jack.conf
	rm -f debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/pipewire-0.3/libpipewire-module-netjack2-*.so
	rm -rf debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/pipewire-0.3/jack \
	       debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)/pipewire-0.3/v4l2

# No documentation and no man pages are built: DOCS=disabled and MAN=disabled
# unconditionally (upstream would build the API reference with doxygen and the
# man pages with xsltproc), so the package pipewire-doc and the *.manpages
# files are gone. -Dtest=disabled stops building the pw-test-* helper programs
# as well; the test suite itself was never run in this build anyway.
# See .clinerules/project.md.
DOCS=disabled
MAN=disabled

built_binaries := $(shell dh_listpackages)

# The SDL2 example driver is off: it was only needed by the video examples of
# the pipewire-tests package, which is not built.
SDL2=disabled

ifneq (,$(filter s390x hppa m68k powerpc ppc64 sparc64,$(DEB_HOST_ARCH)))
BLUEZ5_CODEC_LDAC=disabled
else
BLUEZ5_CODEC_LDAC=enabled
endif

# Debian trixie ships libcamera 0.4.0, but pipewire 1.6.x requires >= 0.6.0 and
# the plugin uses the controls API introduced in libcamera 0.5+, so the libcamera
# source plugin cannot be built here. V4L2 support is disabled as well, so this
# build has no camera source at all.
LIBCAMERA=disabled

# No ML-based audio processing: -Donnxruntime pulls in libonnxruntime and, with
# it, libdnnl, libxnnpack, libcpuinfo, libpthreadpool, libonnx, libprotobuf and
# libre2 - about 70 MB of runtime dependencies for the optional
# spa-filter-graph-plugin-onnx. The ML denoiser/VAD is of no use on a plain
# desktop or server, so the plugin is not built here.
ONNXRUNTIME=disabled

# enable snap support in Ubuntu, Debian's kernel doesn't enable the option
# for fine grained unix mediation at the moment
SNAP=disabled
ifeq (yes,$(shell dpkg-vendor --derives-from Ubuntu && echo yes))
ifneq (,$(filter amd64 arm64 armhf i386 powerpc ppc64el riscv64 s390x,$(DEB_HOST_ARCH)))
SNAP=enabled
endif
endif

ifneq (,$(filter hurd-amd64 hurd-i386,$(DEB_HOST_ARCH)))
UDEVRULESDIR=
else
export UDEVRULESDIR=/usr/lib/udev/rules.d
# For pre-Trixie releases udev rules should go in:
# export UDEVRULESDIR=/lib/udev/rules.d
endif

override_dh_auto_configure:
	dh_auto_configure -- \
		-Daudiotestsrc=enabled \
		-Dauto_features=enabled \
		-Dx11=disabled \
		-Dx11-xfixes=disabled \
		-Davahi=enabled \
		-Dbluez5-backend-native-mm=enabled \
		-Dbluez5-codec-aac=enabled \
		-Dbluez5-codec-aptx=enabled \
		-Dbluez5-codec-lc3=enabled \
		-Dbluez5-codec-lc3plus=disabled \
		-Dbluez5-codec-ldac=$(BLUEZ5_CODEC_LDAC) \
		-Dbluez5-codec-ldac-dec=disabled \
		-Dbluez5-codec-opus=enabled \
		-Dbluez5-plc-spandsp=disabled \
		-Djack=disabled \
		-Dv4l2=disabled \
		-Dlibcamera=$(LIBCAMERA) \
		-Dlibffado=enabled \
		-Dlibmysofa=enabled \
		-Ddocs=$(DOCS) \
		-Dffmpeg=disabled \
		-Dlv2=enabled \
		-Dman=$(MAN) \
		-Donnxruntime=$(ONNXRUNTIME) \
		-Droc=enabled \
		-Dsdl2=$(SDL2) \
		-Dsession-managers= \
		-Dsnap=$(SNAP) \
		-Dsystemd-system-service=enabled \
		-Dsystemd-user-service=enabled \
		-Dtest=disabled \
		-Dudevrulesdir=$(UDEVRULESDIR) \
		-Dvideotestsrc=enabled \
		-Dvulkan=disabled \
		$(NULL)

# No test suite: this repository does not build or run tests, see
# .clinerules/project.md. The -Dtest=disabled configure flag already keeps the
# test tree out of the build, so there is nothing left to run.
override_dh_auto_test:

override_dh_makeshlibs:
	dh_makeshlibs \
		--exclude=/usr/lib/$(DEB_HOST_MULTIARCH)/gstreamer-1.0 \
		--exclude=/usr/lib/$(DEB_HOST_MULTIARCH)/pipewire-0.3 \
		--exclude=/usr/lib/$(DEB_HOST_MULTIARCH)/spa-0.2 \
		-- -c4

override_dh_shlibdeps-arch:
	dh_shlibdeps \
		--remaining-packages \
		-l/usr/lib/$(DEB_HOST_MULTIARCH)/pipewire-0.3 \
		$(NULL)

override_dh_installsystemd:
	# The recommanded way to install pipewire is using user services, but
	# we install system services anyway for specific use cases (like embedded
	# and accessibility) without enabling/starting them to avoid clashes.
	dh_installsystemd -ppipewire-system-services --no-enable --no-start
