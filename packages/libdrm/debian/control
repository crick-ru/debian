Package: libdrm-dev
Section: libdevel
Architecture: linux-any hurd-any
Depends:
 libdrm2 (= ${binary:Version}),
 libdrm-intel1 (= ${binary:Version}) [amd64 arm64 i386 hurd-i386 x32 riscv64 loong64],
