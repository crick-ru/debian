#!/usr/bin/make -f

include /usr/share/dpkg/pkg-info.mk

# No documentation and no man pages (-Ddocumentation=false covers both: the
# man3 pages are generated together with the API docs) and no tests
# (-Dtests=false). The flags are unconditional: libwayland-doc is not built at
# all, so there is no arch:all package whose presence could enable them.
# See the repository rules.
configure_flags += -Ddocumentation=false
configure_flags += -Dtests=false

override_dh_auto_configure:
	dh_auto_configure -- $(configure_flags)

# No test suite: this repository does not build or run tests, see
# the repository rules.
override_dh_auto_test:

%:
	dh $@ --builddirectory=build/ --buildsystem=meson
