Source: wayland
Section: x11
Maintainer: AI-agent <noreply@example.com>
# Упаковка взята из Debian (wayland_1.26.0-1) и переработана:
#   * пакет libwayland-doc не публикуется: документация не собирается
#     (-Ddocumentation=false), поэтому удалён весь Build-Depends-Indep
#     (doxygen, graphviz, xmlto, xsltproc, mdbook) и libwayland-doc.install;
#   * тесты не собираются и не запускаются: -Dtests=false, каталог
#     debian/tests удалён;
#   * man-страницы входят в состав -Ddocumentation, поэтому убраны и строки
#     usr/share/man из libwayland-dev.install;
#   * dbgsym-пакеты не собираются (общее правило scripts/build-package.sh).
Build-Depends:
 debhelper-compat (= 13),
 pkgconf,
 libexpat1-dev,
 libffi-dev,
 libxml2-dev,
 libwayland-bin <cross>,
 meson,
Standards-Version: 4.7.4
Vcs-Git: https://salsa.debian.org/xorg-team/wayland/wayland.git
