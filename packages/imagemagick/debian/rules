#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

include /usr/share/dpkg/architecture.mk

DEB_UPSTREAM_VERSION := $(shell dpkg-parsechangelog -SVersion | sed 's/^[0-9]*://; s/-[0-9]*+crick$$//')
IMVERSION := $(shell echo $(DEB_UPSTREAM_VERSION) | sed -r 's/(^.+)\..+$$/\1/g')
export DEB_HOST_MULTIARCH ?= $(shell dpkg-architecture -qDEB_HOST_MULTIARCH)

# Диспетчер debhelper. Без него make не знает, что делать с целями clean,
# build, binary: tar-бол ImageMagick приходит уже с готовым configure,
# поэтому сборка - обычная autoconf/autotools.
%:
	dh $@ --buildsystem=autoconf

# X11 is switched off: this repository has no X11 anywhere, and Debian builds
# ImageMagick with --x-includes/--x-libraries, which would drag libx11-dev,
# libxext-dev and libxt-dev in and link libMagickCore against libX11/libXext.
# Upstream guards every X11 use with MAGICKCORE_X11_DELEGATE, so --without-x
# needs no patch. The "display" and "import" tools are still built, but they
# cannot work without an X11 delegate; they are dropped from the staging tree
# in override_dh_auto_install below.
#
# The HEIC delegate is switched on: --with-heic runs the
# PKG_CHECK_MODULES([HEIF],[libheif >= 1.7.0]) check, HEIC_DELEGATE is defined
# and coders/heic.c is compiled; no patch is needed for that. That one coder
# registers four formats - HEIC, HEIF, AVCI and AVIF - all guarded by
# MAGICKCORE_HEIC_DELEGATE, so enabling HEIC brings AVIF along: upstream has no
# separate switch for AVIF. Only coders/heic.so has libheif.so.1 in DT_NEEDED
# (the main library does not link libheif), so libheif1 enters the runtime
# dependencies of libmagickcore-7.q16-10 through the coder module. libheif is
# built by this repository as libheif1 + libheif-dev (with the codec plugins
# inside libheif1); see packages/libheif and README.md.
#
# Only the Q16 quantum depth is built. Debian builds Q16 *and* Q16HDRI, which
# doubles the compile time for a second ABI variant that this repository does
# not need; the HDRI packages of trixie keep working with their own libraries.
#
# PerlMagick and Magick++ are not built: neither is needed by any package of
# this repository, and PerlMagick would drag in perl plus its own examples and
# test tree, which the project rules forbid anyway.
#
# No documentation is built: the imagemagick-7-doc package is not published
# and /usr/share/doc is removed from the staging directory below. See
# the repository rules.
#
# --with-security-policy=secure is the strictest variant that upstream's own
# configure accepts (open|limited|secure|websafe). The value "debian" that
# Debian passes works only with their patched configure, so it is not an
# option here; "secure" is the closest upstream equivalent: it denies direct
# file access, blocks the "follow" coder and path traversal, and allows
# writing only through the safe coder list. Anyone who needs a coder that it
# blocks switches the value to limited or open - see the README.
override_dh_auto_configure:
	dh_auto_configure -- \
		--prefix=/usr \
		--libdir=/usr/lib/$(DEB_HOST_MULTIARCH) \
		--sysconfdir=/etc \
		--with-includearch-dir=/usr/include/$(DEB_HOST_MULTIARCH)/ \
		--with-quantum-depth=16 \
		--enable-hdri=no \
		--with-modules \
		--without-x \
		--without-magick-plus-plus \
		--without-perl \
		--without-gvc \
		--without-rsvg \
		--without-dps \
		--without-fpx \
		--with-djvu \
		--with-heic \
		--with-openjp2 \
		--with-webp \
		--with-wmf \
		--with-fftw \
		--with-security-policy=secure \
		--enable-reproducible-build \
		--without-gcc-arch \
		MVDelegate=/bin/mv \
		RMDelegate=/bin/rm

# Upstream installs its HTML documentation, the ChangeLog and the man pages
# under /usr/share/doc and /usr/share/man. None of that is published here, so
# it is dropped from the staging directory; otherwise dh_missing
# --fail-missing (the compat 13 default) would abort the build.
#
# Two more things are dropped, both deliberately:
#   * display and import - the X11 tools. They are still built even with
#     --without-x (the flag only removes the X11 coder), but without an X11
#     delegate they cannot do anything, and the description of
#     imagemagick-7.q16 says they are not shipped. They are the only two
#     binaries the .install files did not name.
#   * the libtool archives (*.la). libtool prefers a .la over the .so of the
#     same name, so a package built against ours would link the static library
#     and keep the build directory's paths inside the result. The static
#     libraries themselves (*.a) are shipped, as in Debian.
override_dh_auto_install:
	dh_auto_install
	rm -rf debian/tmp/usr/share/doc debian/tmp/usr/share/man
	rm -f debian/tmp/usr/bin/display debian/tmp/usr/bin/import
	find debian/tmp/usr/lib -name '*.la' -delete

# No test suite: this repository neither builds nor runs tests, see
# the repository rules. "make check" of ImageMagick runs a large Perl- and
# Ghostscript-based suite; override_dh_auto_test keeps it from being invoked.
override_dh_auto_test:

# The coder and filter modules are dlopened modules built with libtool; they
# must keep their SONAMEs, and neither dh_makeshlibs nor dpkg-shlibdeps should
# try to resolve them. Debian does the same: the two module directories are
# excluded from the shlibs calculation, which is why the call is repeated per
# binary package instead of being made once.
override_dh_makeshlibs:
	# avoid plugins' dir
	FAIL=0; \
	for PKG in $$(dh_listpackages -a); do \
		echo dh_makeshlibs -p$$PKG -Xcoders/ -Xfilters/; \
		dh_makeshlibs -p$$PKG -Xcoders/ -Xfilters/; \
		FAIL=$$?; \
	done; \
	exit $$FAIL

# No options of its own: debhelper 13 knows neither --no-missing-info nor
# --ignore-missing-info (both are rejected as unknown options), and missing
# shlibs information is not fatal by default anyway. Verbose output is on for
# the same reason as in the Debian packaging.
override_dh_shlibdeps:
	dh_shlibdeps -- -v
