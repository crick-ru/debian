Source: imagemagick
Section: graphics
Priority: optional
Maintainer: crick Debian Backports <backports@users.noreply.github.com>
# Упаковка взята из Debian (imagemagick_8:7.1.1.43+dfsg1-1) и переработана:
#   * X11 выключен (--without-x): Debian собирает ImageMagick с
#     --x-includes/--x-libraries, здесь X11-делегат не собирается вовсе,
#     поэтому libx11-dev, libxext-dev и libxt-dev убраны из Build-Depends, а
#     в пакетах нет зависимостей libx11-6/libxext-6;
#   * собирается только квантовая глубина Q16 (--with-quantum-depth=16),
#     Q16HDRI не собирается - это второй полный проход компиляции;
#   * PerlMagick и Magick++ не собираются (--without-perl
#     --without-magick-plus-plus);
#   * документация и man-страницы не собираются, пакет imagemagick-7-doc не
#     публикуется, каталог /usr/share/doc удаляется из дерева установки;
#   * тесты не собираются и не запускаются (make check не вызывается,
#     override_dh_auto_test пуст);
#   * символьные файлы не поставляются - их генерирует dh_makeshlibs;
#   * dbgsym-пакеты не собираются (общее правило scripts/build-package.sh).
# Правила отключения - в .clinerules/project.md.
Build-Depends: debhelper-compat (= 13),
               chrpath,
               pkgconf,
               libltdl-dev,
