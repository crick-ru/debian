#!/usr/bin/make -f
# Сборка GStreamer libav 1.28.7 для crick Debian backports. Упаковка взята из
# Debian (gst-libav1.0 1.28.7-1) и упрощена: нет документации и тестов.
# Плагин собирается против ffmpeg этого репозитория (9.0.2). Подробности —
# в packages/gstreamer1.0-libav/README.md.

include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS := hardening=+all

# Ключевые решения:
#   -Ddoc=disabled   документация не собирается;
#   -Dtests=disabled тестовая система не собирается и не запускается.
# Ничего больше выключать не нужно: сам плагин не обращается ни к X11, ни к
# оптическим дискам, ни к VDPAU. Видеосинки лежат в наборах base и good, а
# они собраны без X11.
conf_flags = \
	-Dpackage-name=GStreamer \
	-Dpackage-origin=https://gstreamer.freedesktop.org \
	-Dauto_features=enabled \
	-Ddoc=disabled \
	-Dtests=disabled \
	-Dexamples=disabled

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- $(conf_flags)

override_dh_auto_test:

override_dh_installman:
	# man-страницы не собираются (-Ddoc=disabled)
	dh_installman --no-package