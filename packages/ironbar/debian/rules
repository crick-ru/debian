#!/usr/bin/make -f

export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_LDFLAGS_MAINT_APPEND = -Wl,-z,defs
export RUST_LOG = off
export CARGO_NET_OFFLINE = false

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_test:

override_dh_auto_build:
	cargo fetch --locked
	cargo build --release --locked --offline

override_dh_auto_install:
	install -D -m 755 target/release/ironbar debian/tmp/usr/bin/ironbar
	install -D -m 644 ironbar.service debian/tmp/usr/lib/systemd/user/ironbar.service
	# Install upstream example configurations (ironbar has no default config;
	# users need a starting point — see rule "примеры конфигурационных файлов")
	install -d -m 755 debian/tmp/usr/share/doc/ironbar/examples
	cp -r examples/* debian/tmp/usr/share/doc/ironbar/examples/
