#!/usr/bin/env python3
"""Сгенерировать libxcb.so.1 — логирующую заглушку, которая перехватывает
все вызовы xcb_* функций Яндекс.Браузера, логирует их, и возвращает 0/null.

rev 9: НЕ делегируем реальной libxcb. Все функции xcb_* возвращают 0 или NULL.
Это упрощённый подход — браузер не получает real X11 connection, но в
чистом Wayland окружении это достаточно: X11-код в браузере не используется
для рендеринга, а заглушка удовлетворяет все ссылки на символы.

Специальные переопределения (STUB_OVERRIDES + INT_OVERRIDE_TEMPLATE).
Основные функции переопределяются на безопасные значения:
- xcb_connect, xcb_connect_to_display_with_auth_info → NULL (0x0)
- xcb_connection_has_error → 0 (int, использует INT_OVERRIDE_TEMPLATE)
- xcb_generate_id → 0xffffffff
- xcb_flush, xcb_disconnect → 0

Логирующая заглушка НЕ использует реальную libxcb (dlopen больше не вызывается).
Это упрощает архитектуру: не нужно скрывать real libxcb, не нужно переключать
делегирование на заглушку.

Устройство. Для каждого из 676 символов xcb_* генерируется функция-обёртка,
которая:
  1. Сохраняет аргументы из регистров (rdi, rsi, rdx, rcx, r8, r9) в локальные
     переменные — до любых вызовов, которые могут их испортить.
  2. Логгирует вызов (название + аргументы) в /tmp/dummy-x11-libxcb.log
     (или путь из env YABROWSER_XCB_LOG).
  3. Возвращает заранее определённое значение из STUB_OVERRIDES или
     INT_OVERRIDE_TEMPLATE (для int-функций).

Вход:  symbols-libxcb.so.1.txt (список символов).
Выход: libxcb.so.1 (логирующая заглушка, SONAME libxcb.so.1).
"""

import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))

# Путь к списку символов.
SYMBOLS_FILE = "symbols-libxcb.so.1.txt"

# Функции, для которых возвращаем жёсткое значение вместо делегирования
# реальной libxcb. Ключ — имя функции, значение — C-выражение для возврата.
#
# Подход rev 9: НЕ делегируем ни одну функцию. Все функции xcb_* возвращают
# 0 или NULL. xcb_connect и xcb_connect_to_display_with_auth_info возвращают
# NULL (не real connection pointer). xcb_connection_has_error возвращает 0
# (no error) — для этого нужен INT_OVERRIDE_TEMPLATE (int, не void*).
#
# Реальная libxcb не используется — полностью заменена заглушкой. Это
# упрощённый подход: браузер не получает real X11 connection, но X11-код
# в нём отключён через #ifdef при сборке, либо загружается как null-заглушка.
# В чистом Wayland окружении X11 connection не используется для рендеринга.
#
# generate_id переопределяется на 0xffffffff (валидный XID), flush/disconnect
# на 0 — safe values для неиспользуемого соединения.
STUB_OVERRIDES = {
    'xcb_generate_id': '(void*)0xffffffff',
    'xcb_flush': '(void*)0',
    'xcb_disconnect': '(void*)0',
    'xcb_connect': '(void*)0',
    'xcb_connect_to_display_with_auth_info': '(void*)0',

    # xcb_connection_has_error возвращает int, не void*.
    # Использует INT_OVERRIDE_TEMPLATE (отдельный шаблон ниже).
    'xcb_connection_has_error': None,
}


def read_symbols():
    lst = os.path.join(HERE, SYMBOLS_FILE)
    with open(lst, encoding='utf-8') as fh:
        return [line.strip() for line in fh if line.strip()]



# Шаблон для функций, возвращающих int (не void*).
# В отличие от OVERRIDE_TEMPLATE (void*), этот используется для
# xcb_connection_has_error, который возвращает int.
INT_OVERRIDE_TEMPLATE = """
int {name}(void) {{
    /* Захват аргументов из регистров до любых вызовов */
    register void *a0 asm("rdi");
    register void *a1 asm("rsi");
    register void *a2 asm("rdx");
    register void *a3 asm("rcx");
    register void *a4 asm("r8");
    register void *a5 asm("r9");
    void *sv0 = a0, *sv1 = a1, *sv2 = a2, *sv3 = a3, *sv4 = a4, *sv5 = a5;

    log_entry("{name}", sv0, sv1, sv2, sv3, sv4, sv5);

    int ret = 0;
    log_exit_int("{name}", ret);
    return ret;
}}

"""


LOG_HEADER = """\
/* Логирующая заглушка libxcb. Сгенерировано gen-libxcb-stub.
 * Не редактируйте этот файл — редактируйте symbols-libxcb.so.1.txt и
 * перегенерируйте через gen-stubs. */

#define _GNU_SOURCE
#include <stdio.h>
#include <stdint.h>
#include <pthread.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define LOG_PATH_ENV "YABROWSER_XCB_LOG"
#define LOG_PATH_DEFAULT "/tmp/dummy-x11-libxcb.log"

static FILE *g_log = NULL;
static pthread_mutex_t g_log_lock = PTHREAD_MUTEX_INITIALIZER;
static unsigned long g_call_counter = 0;

static const char *get_log_path(void) {{
    const char *p = getenv(LOG_PATH_ENV);
    return p ? p : LOG_PATH_DEFAULT;
}}

__attribute__((constructor))
static void xcb_stub_init(void) {{
    g_log = fopen(get_log_path(), "a");
    if (!g_log) {{
        g_log = stderr;
    }}
    setvbuf(g_log, NULL, _IONBF, 0);
    fprintf(g_log, "[init] libxcb logging stub loaded (no delegation)\\n");
    fprintf(g_log, "[init] log path: %s\\n", get_log_path());
    fprintf(g_log, "[init] all xcb_* calls return 0/null\\n");
}}

static void log_entry(const char *name,
                      void *a0, void *a1, void *a2, void *a3,
                      void *a4, void *a5) {{
    pthread_mutex_lock(&g_log_lock);
    if (g_log) {{
        fprintf(g_log, "[call #%lu] %s(a0=%p a1=%p a2=%p a3=%p a4=%p a5=%p)\\n",
                g_call_counter++, name, a0, a1, a2, a3, a4, a5);
    }}
    pthread_mutex_unlock(&g_log_lock);
}}

static void log_exit(const char *name, void *ret) {{
    pthread_mutex_lock(&g_log_lock);
    if (g_log) {{
        fprintf(g_log, "[ret  #%lu] %s -> %p\\n", g_call_counter, name, ret);
    }}
    pthread_mutex_unlock(&g_log_lock);
}}

static void log_exit_int(const char *name, int ret) {{
    pthread_mutex_lock(&g_log_lock);
    if (g_log) {{
        fprintf(g_log, "[ret  #%lu] %s -> %d\\n", g_call_counter, name, ret);
    }}
    pthread_mutex_unlock(&g_log_lock);
}}

"""


# Шаблон для функций с возвращаемым значением по умолчанию (0/null).
# Логирует вызов, но вместо делегирования реальной libxcb возвращает
# нулевое значение. Используется для всех функций xcb_*, которые не
# перечислены в STUB_OVERRIDES (основная часть — 670+ символов).
# Возвращаемый тип void* — для xcb функций, возвращающих int/size_t/uint32_t,
# нулевой void* даёт 0 нужного типа на x86-64 ABI.
ZERO_TEMPLATE = """
void *{name}(void) {{
    register void *a0 asm("rdi");
    register void *a1 asm("rsi");
    register void *a2 asm("rdx");
    register void *a3 asm("rcx");
    register void *a4 asm("r8");
    register void *a5 asm("r9");
    void *sv0 = a0, *sv1 = a1, *sv2 = a2, *sv3 = a3, *sv4 = a4, *sv5 = a5;

    log_entry("{name}", sv0, sv1, sv2, sv3, sv4, sv5);

    void *ret = (void*)0;
    log_exit("{name}", ret);
    return ret;
}}

"""


# Шаблон для функций с переопределённым возвращаемым значением (STUB_OVERRIDES).
# Логирует вызов, но вместо делегирования реальной libxcb возвращает
# заранавливаемое значение.
OVERRIDE_TEMPLATE = """\
void *{name}(void) {{
    /* Захват аргументов из регистров до любых вызовов */
    register void *a0 asm("rdi");
    register void *a1 asm("rsi");
    register void *a2 asm("rdx");
    register void *a3 asm("rcx");
    register void *a4 asm("r8");
    register void *a5 asm("r9");
    void *sv0 = a0, *sv1 = a1, *sv2 = a2, *sv3 = a3, *sv4 = a4, *sv5 = a5;

    log_entry("{name}", sv0, sv1, sv2, sv3, sv4, sv5);

    void *ret = {override};
    log_exit("{name}", ret);
    return ret;
}}

"""


def main():
    outdir = sys.argv[1] if len(sys.argv) > 1 else '.'
    srcdir = os.path.join(outdir, '.src')
    os.makedirs(srcdir, exist_ok=True)

    symbols = read_symbols()
    print('==> symbols-libxcb.so.1.txt: %d символов' % len(symbols))

    csrc = os.path.join(srcdir, 'libxcb-stub.c')
    so = os.path.join(outdir, 'libxcb.so.1')

    with open(csrc, 'w', encoding='utf-8') as fh:
        fh.write(LOG_HEADER)
        for sym in symbols:
            if sym == 'xcb_connection_has_error':
                fh.write(INT_OVERRIDE_TEMPLATE.format(name=sym))
            elif sym in STUB_OVERRIDES and STUB_OVERRIDES[sym] is not None:
                fh.write(OVERRIDE_TEMPLATE.format(
                    name=sym, override=STUB_OVERRIDES[sym]))
            else:
                fh.write(ZERO_TEMPLATE.format(name=sym))

    print('==> compiling %s (%d wrappers)' % (so, len(symbols)))
    subprocess.run(
        ['gcc', '-shared', '-fPIC', '-O2',
         '-o', so, csrc,
         '-ldl',
         '-Wl,-soname,libxcb.so.1'],
        check=True)

    print('==> %s: %d символов (логирующая заглушка)' % (so, len(symbols)))


if __name__ == '__main__':
    main()
