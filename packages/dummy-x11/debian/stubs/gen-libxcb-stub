#!/usr/bin/env python3
"""Сгенерировать libxcb.so.1 — логирующую заглушку, которая перехватывает
все вызовы xcb_* функций Яндекс.Браузера, логирует их и больше НИЧЕГО не
делегирует: настоящей libxcb в пакете нет, и вызовы на неё не поступают.

Зачем. Настоящий libxcb.so.1 из trixie в пакете был заменён на эту заглушку,
чтобы выяснить, какие именно функции и ответы нужны браузеру. Сгенерированная
заглушка логгирует все вызовы и (раньше) делегировала их настоящей библиотеке,
которая стояла по скрытому пути. Теперь делегирования нет: после анализа лога
стали понятны все вызовы браузера, и они переопределены на жёсткие значения.
Остальные функции (которые браузер не зовёт) просто логгируются и возвращают NULL.

Устройство. Для каждого из 676 символов xcb_* генерируется функция-обёртка:
  1. Сохраняет аргументы из регистров (rdi, rsi, rdx, rcx, r8, r9) в локальные
     переменные — до любых вызовов, которые могут их испортить.
  2. Логгирует вызов (название + аргументы) в /tmp/dummy-x11-libxcb.log
     (или путь из env YABROWSER_XCB_LOG).
  3. Возвращает заранее известное значение:
     - для функций из STUB_OVERRIDES — своё hardcoded-значение;
     - для остальных — NULL.
  Никакого dlopen/dlsym, никакой реальной libxcb — пакет не содержит и не
  загружает её. Это требует пользователь: браузер должен работать без X-сервера.

Вход:  symbols-libxcb.so.1.txt (список символов).
Выход: libxcb.so.1 (логирующая заглушка, SONAME libxcb.so.1).
"""

import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))

# Путь к списку символов.
SYMBOLS_FILE = "symbols-libxcb.so.1.txt"

# Функции, для которых возвращаем жёсткое значение вместо NULL.
# Ключ — имя функции, значение — C-выражение для возврата.
# Подробности в докстринге выше.
#
# Значения взяты из лога (1-е октября 2026, Яндекс Браузер): браузер
# вызывает ровно эти 6 функций, и без них не обойтись — остальные 670
# функций не зовутся и возвращают NULL.
STUB_OVERRIDES = {
    'xcb_connect': '(void*)0x1',
    'xcb_connect_to_display_with_auth_info': '(void*)0x1',
    'xcb_connection_has_error': '(void*)0x5',
    'xcb_generate_id': '(void*)0xffffffff',
    'xcb_flush': '(void*)0',
    'xcb_disconnect': '(void*)0',
}

# Список функций, которые логгируются, но не делегируются реальной libxcb.
# Остальные 670 функций (из symbols-libxcb.so.1.txt) логгируются и
# возвращают NULL — это корректно для системы без X-сервера: функции, которые
# браузер не зовёт, вызываться не будут, а если и будут (транзитивные),
# NULL для них допустим.


def read_symbols():
    lst = os.path.join(HERE, SYMBOLS_FILE)
    with open(lst, encoding='utf-8') as fh:
        return [line.strip() for line in fh if line.strip()]


LOG_HEADER = r"""\
/* Логирующая заглушка libxcb. Сгенерировано gen-libxcb-stub.
 * Не редактируйте этот файл — редактируйте symbols-libxcb.so.1.txt и
 * перегенерируйте через gen-stubs.
 *
 * Никакой реальной libxcb нет и не загружается: пакет не содержит её, и
 * делегирования вызовов на неё не происходит. Каждая функция либо возвращает
 * своё hardcode-значение (STUB_OVERRIDES), либо логирует вызов и возвращает
 * NULL. Это корректно для системы без X-сервера: функции, которые браузер
 * не зовёт, вызываться не будут.
 */

#define _GNU_SOURCE
#include <stdio.h>
#include <stdint.h>
#include <pthread.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>

#define LOG_PATH_ENV "YABROWSER_XCB_LOG"
#define LOG_PATH_DEFAULT "/tmp/dummy-x11-libxcb.log"

static FILE *g_log = NULL;
static pthread_mutex_t g_log_lock = PTHREAD_MUTEX_INITIALIZER;
static unsigned long g_call_counter = 0;

static const char *get_log_path(void) {
    const char *p = getenv(LOG_PATH_ENV);
    return p ? p : LOG_PATH_DEFAULT;
}

__attribute__((constructor))
static void xcb_stub_init(void) {
    g_log = fopen(get_log_path(), "a");
    if (!g_log) {
        g_log = stderr;
    }
    setvbuf(g_log, NULL, _IONBF, 0);
    fprintf(g_log, "[init] libxcb logging wrapper loaded\n");
    fprintf(g_log, "[init] log path: %s\n", get_log_path());
    fprintf(g_log, "[init] real library: none (delegation removed)\n");
}

static void log_entry(const char *name,
                      void *a0, void *a1, void *a2, void *a3,
                      void *a4, void *a5) {
    pthread_mutex_lock(&g_log_lock);
    if (g_log) {
        fprintf(g_log, "[call #%lu] %s(a0=%p a1=%p a2=%p a3=%p a4=%p a5=%p)\n",
                g_call_counter++, name, a0, a1, a2, a3, a4, a5);
    }
    pthread_mutex_unlock(&g_log_lock);
}

static void log_exit(const char *name, void *ret) {
    pthread_mutex_lock(&g_log_lock);
    if (g_log) {
        fprintf(g_log, "[ret  #%lu] %s -> %p\n", g_call_counter, name, ret);
    }
    pthread_mutex_unlock(&g_log_lock);
}
"""


WRAPPER_TEMPLATE = """\
void *{name}(void) {{
    /* Захват аргументов из регистров до любых вызовов */
    register void *a0 asm("rdi");
    register void *a1 asm("rsi");
    register void *a2 asm("rdx");
    register void *a3 asm("rcx");
    register void *a4 asm("r8");
    register void *a5 asm("r9");
    void *sv0 = a0, *sv1 = a1, *sv2 = a2, *sv3 = a3, *sv4 = a4, *sv5 = a5;

    log_entry("{name}", sv0, sv1, sv2, sv3, sv4, sv5);

    /* Никакой делегации на реальную libxcb: пакет её не содержит. Возвращаем
     * NULL — для функций, которые браузер не зовёт, это допустимо (X-сервера
     * в системе нет), а если какая-то функция понадобится — она попадёт в лог
     * и её добавят в STUB_OVERRIDES. */
    void *ret = NULL;
    log_exit("{name}", ret);
    return ret;
}}

"""


# Шаблон для функций с переопределённым возвращаемым значением (STUB_OVERRIDES).
# Логирует вызов и возвращает заранее заданное значение.
OVERRIDE_TEMPLATE = """\
void *{name}(void) {{
    /* Захват аргументов из регистров до любых вызовов */
    register void *a0 asm("rdi");
    register void *a1 asm("rsi");
    register void *a2 asm("rdx");
    register void *a3 asm("rcx");
    register void *a4 asm("r8");
    register void *a5 asm("r9");
    void *sv0 = a0, *sv1 = a1, *sv2 = a2, *sv3 = a3, *sv4 = a4, *sv5 = a5;

    log_entry("{name}", sv0, sv1, sv2, sv3, sv4, sv5);

    void *ret = {override};
    log_exit("{name}", ret);
    return ret;
}}

"""


def main():
    outdir = sys.argv[1] if len(sys.argv) > 1 else '.'
    srcdir = os.path.join(outdir, '.src')
    os.makedirs(srcdir, exist_ok=True)

    symbols = read_symbols()
    print('==> symbols-libxcb.so.1.txt: %d символов' % len(symbols))

    csrc = os.path.join(srcdir, 'libxcb-stub.c')
    so = os.path.join(outdir, 'libxcb.so.1')

    with open(csrc, 'w', encoding='utf-8') as fh:
        fh.write(LOG_HEADER)
        for sym in symbols:
            if sym in STUB_OVERRIDES:
                fh.write(OVERRIDE_TEMPLATE.format(
                    name=sym, override=STUB_OVERRIDES[sym]))
            else:
                fh.write(WRAPPER_TEMPLATE.format(name=sym))

    print('==> compiling %s (%d wrappers)' % (so, len(symbols)))
    subprocess.run(
        ['gcc', '-shared', '-fPIC', '-O2',
         '-o', so, csrc,
         '-Wl,-soname,libxcb.so.1'],
        check=True)

    print('==> %s: %d символов (логирующая заглушка, без делегирования)'
          % (so, len(symbols)))


if __name__ == '__main__':
    main()
