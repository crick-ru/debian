#!/usr/bin/make -f
# Сборка dummy-x11: пакет без исходников, состоящий из единой заглушки X11
# (dummy-x11.so с симлинками), логирующей заглушки libxcb.so.1 (без
# делегирования — настоящей libxcb в пакете нет) и diagnosticного скрипта.
# Подробности - в packages/dummy-x11/README.md.

export DEB_BUILD_MAINT_OPTIONS = hardening=+all

STUBDIR := debian/stubs
BUILDDIR := $(CURDIR)/build-stubs
# DEB_HOST_MULTIARCH, а не $(shell dpkg-architecture ...): переменную
# экспортирует dpkg-buildpackage, и в правилах она уже есть. `:=` здесь
# не годится: значение вычисляется на момент чтения строки, когда make
# ещё не видел окружения сборки, и каталог получался пустым.
LIBDIR   := debian/tmp/usr/lib/$(DEB_HOST_MULTIARCH)

%:
	dh $@

# Сгенерировать библиотеки-заглушки. gen-stubs создаёт:
#   1. dummy-x11.so + симлинки lib*.so.* (заглушки libX11, libXext, etc.)
#   2. libxcb.so.1 (логирующая заглушка, SONAME libxcb.so.1). Настоящей
#      libxcb в пакете нет — все функции либо возвращают hardcode-значение
#      (6 функций, которые зовёт браузер), либо логгируются и возвращают NULL.
#      Списки символов лежат в debian/stubs/ (сняты с настоящих библиотек
#      trixie readelf --dyn-syms).
override_dh_auto_build:
	python3 $(STUBDIR)/gen-stubs $(BUILDDIR)

override_dh_auto_install:
	install -d $(LIBDIR)
	install -m 0644 $(BUILDDIR)/dummy-x11.so $(LIBDIR)/
	# Симлинки libX*.so.*: cp -P сохраняет их симлинками, install скопировал бы
	# цель под каждым именем (лишние копии файла вместо ссылок на одну заглушку).
	cp -P $(BUILDDIR)/lib*.so.* $(LIBDIR)/
	# Диагностический скрипт - то, чем пользователь проверяет браузер
	# после обновления. Ставится в /usr/bin, чтобы вызывался просто
	# `dummy-x11-report`.
	install -d debian/tmp/usr/bin
	install -m 0755 $(STUBDIR)/dummy-x11-report \
		debian/tmp/usr/bin/dummy-x11-report
	install -d debian/tmp/usr/share/dummy-x11
	install -m 0755 $(STUBDIR)/gen-stubs debian/tmp/usr/share/dummy-x11/
	install -m 0755 $(STUBDIR)/gen-libxcb-stub debian/tmp/usr/share/dummy-x11/
	# Списки символов ставятся вместе со скриптом: он сверяет импорты
	# браузера именно с ними и без них ничего не смог бы проверить
	# (см. known_symbols() в dummy-x11-report).
	install -m 0644 $(STUBDIR)/symbols-*.txt debian/tmp/usr/share/dummy-x11/

# dpkg-shlibdeps отключён намеренно. dummy-x11 имеет фиктивный SONAME и не
# может участвовать в dependency generation. Внешних зависимостей у пакета
# нет по замыслу (см. README).
# Без отключения dpkg-shlibdeps потребовал бы в Build-Depends настоящие
# X11-библиотеки из trixie только ради метаданных для своей проверки.
override_dh_shlibdeps: