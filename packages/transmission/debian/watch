# Project: @PACKAGE@
# Matching-Pattern: @ANY_VERSION@/@PACKAGE@\-@ANY_VERSION@\.tar\.xz
# Dversion-Mangle: s/\+dfsg$//
# Uversion-Mangle: auto
# Repacksuffix: +dfsg
