#!/usr/bin/make -f
# Сборка GStreamer Good Plugins 1.28.7 для crick Debian backports. Упаковка
# взята из Debian (gst-plugins-good1.0 1.28.7-1) и упрощена: нет видеосинков
# Qt и GTK, нет документации и тестов, не публикуется плагин PulseAudio
# (звук обслуживает pipewire). Подробности — в README пакета.

include /usr/share/dpkg/architecture.mk

export DEB_BUILD_MAINT_OPTIONS := hardening=+all

# Ключевые решения:
#   -Dauto_features не задаётся намеренно. Это встроенная опция meson: она
#                         превращает все опции со значением 'auto' в 'enabled',
#                         то есть необязательные зависимости становятся
#                         обязательными. Сборка на этом ломалась по очереди на
#                         nasm (опция asm), затем на libraw1394/libavc1394/
#                         libiec61883 (dv1394) и libgudev/libv4l2 (v4l2).
#                         Состав набора задают перечисленные ниже отключения
#                         плюс фактический состав Build-Depends, а .install
#                         приведён в соответствие с фактически собираемыми
#                         плагинами;
#   -Dqt5=disabled -Dqt6=disabled
#                         видеосинки Qt основаны на QML, то есть на
#                         X11-ориентированном API. В репозитории нет ни Qt,
#                         ни X11, а видео показывают labwc и mpv;
#   -Dgtk3=disabled       видеосинк GTK 3 не нужен: тот же GTK 3 уже есть
#                         в репозитории, но без X11, и задачу вывода
#                         видео решает labwc;
#   -Dximagesrc=disabled  единственный X11-плагин набора, ximagesrc, не
#                         собирается: в репозитории нет X11 вообще. Важно:
#                         опции 'x11' в gst-plugins-good 1.28.7 НЕТ вообще
#                         (есть 'ximagesrc' и её подопции xshm/xfixes/
#                         xdamage/navigation), поэтому прежний -Dx11=disabled
#                         срывал конфигурацию с "Unknown options: x11";
#   -Dpulse=disabled      плагин libgstpulseaudio.so не публикуется: звук
#                         обслуживает pipewire с pulse-совместимостью. Раньше
#                         строка была убрана только из .install, и сборку
#                         ронял dh_missing --fail-missing (в compat 13 это
#                         поведение по умолчанию) на неустановленном файле;
#                         libpulse-dev убран из Build-Depends, mpv имеет свой;
#   -Dv4l2=disabled       захват с видеоустройств (V4L2) не нужен - это
#                         телекамеры и ТВ-тюнеры, тот же класс, что DVB;
#   -Djack=disabled       JACK-плагин libgstjack.so не публикуется: звук
#                         обслуживает pipewire, а JACK-клиенту нужен
#                         JACK-сервер (jackd2 из дистрибутива);
#   -Dlibcaca=disabled    плагин libgstcacasink.so не публикуется: вывод
#                         видео в текстовую консоль, тот же класс, что
#                         aalib;
#   -Daalib=disabled      плагин libgstaasink.so не публикуется по той же
#                         причине. Опция называется aalib (не aa1), хотя
#                         пакет Debian называется libaa1-dev: проверка в
#                         ext/aalib/meson.build идёт по заголовку aalib.h и
#                         по -laa, и именно их даёт libaa1-dev;
#   -Daudiofx=disabled  плагин libgstaudiofx.so не публикуется: чистый плагин
#                       без внешних зависимостей, исключён по списку
#                       репозитория (аудио-эффекты не нужны клиентам);
#   -Damrnb/amrwbdec    AMR (NB/WB) выключены: кодеки не используются, поэтому
#                       libopencore-amrnb-dev и libopencore-amrwb-dev убраны;
#   -Dspeex=disabled    Speex выключен — аудио идёт через Opus/Vorbis, libspeex-dev
#                       убран;
#   -Dwavpack=disabled  WavPack выключен, libwavpack-dev убран.
#   -Doss4=disabled       устаревший аудио-API OSSv4; звук идёт через
#                         ALSA и pipewire;
#   -Dshout2=disabled     плагин libgstshout2.so (icecastsink) не публикуется:
#                         это отправка потока на Icecast-сервер, серверов
#                         в репозитории нет. libshout-dev убран из Build-Depends;
#   -Ddoc=disabled        документация не собирается;
#   -Dtests=disabled      тестовая система не собирается и не запускается.
conf_flags = \
	-Dpackage-name=GStreamer \
	-Dpackage-origin=https://gstreamer.freedesktop.org \
	-Ddoc=disabled \
	-Dtests=disabled \
	-Dexamples=disabled \
	-Dqt5=disabled \
	-Dqt6=disabled \
	-Dgtk3=disabled \
	-Dximagesrc=disabled \
	-Dpulse=disabled \
	-Dv4l2=disabled \
	-Djack=disabled \
	-Dlibcaca=disabled \
	-Daalib=disabled \
	-Daudiofx=disabled \
	-Damrnb=disabled \
	-Damrwbdec=disabled \
	-Dspeex=disabled \
	-Dwavpack=disabled \
	-Doss4=disabled \
	-Dshout2=disabled

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure -- $(conf_flags)

override_dh_auto_test:

# dh_auto_install при единственном бинарном пакете ставит файлы прямо в
# debian/<package>/, а dh_install ищет их в текущем каталоге и в
# debian/tmp (см. dh_install(1), раздел FILES). Без явного destdir
# получается расхождение: meson ставит в
# debian/gstreamer1.0-plugins-good/, а dh_install затем сообщает
# "Cannot find (any matches for) ..." на каждый плагин и обрывает
# сборку. После удаления пакетов с библиотеками в наборе остался ровно
# один бинарный пакет, поэтому destdir задан явно.
override_dh_auto_install:
	dh_auto_install --destdir=debian/tmp

override_dh_makeshlibs:
	dh_makeshlibs -- -c4